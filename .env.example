# Copy this file to .env in the same directory as docker-compose.yaml
# (e.g. /opt/indy-node/.env) before running `docker compose up`.
#
# docker compose automatically loads a file literally named `.env` from the
# project directory - the directory containing the compose file passed via
# -f, unless overridden with --env-file/--project-directory. These values
# fill in the ${NODE_IP}/${NODE_PORT}/${CLIENT_IP}/${CLIENT_PORT} references
# in docker-compose.yaml; if left unset, docker compose silently defaults
# them to blank strings, which breaks the port mapping at container start.

NODE_IP=
NODE_PORT=
CLIENT_IP=
CLIENT_PORT=
